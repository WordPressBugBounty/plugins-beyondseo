msgid "Your session has expired or the activation is no longer valid. Please reactivate your account to continue."
msgstr "Tvoja relácia vypršala alebo aktivácia už nie je platná. Ak chceš pokračovať, reaktivuj si svoj účet."

msgid "Reset and Reactivate"
msgstr "Resetovať a reaktivovať"

msgid "Need help? Contact our support team for assistance."
msgstr "Potrebuješ pomoc? Požiadaj o pomoc náš tím podpory."

msgid "Copied!"
msgstr "Skopírované!"

msgid "Activate your free account to track your visibility, improve your rankings and grow your business"
msgstr "Aktivuj si svoj bezplatný účet, aby si mohol sledovať svoju viditeľnosť, zlepšovať svoje pozície a rozvíjať svoje podnikanie"

