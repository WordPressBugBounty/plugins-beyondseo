msgstr "Táto stránka neobsahuje dostatočné informácie o miestnych podnikoch na to, aby si zaslúžila schému značkovania."

#: app/src/Domain/Integrations/WordPress/Seo/Entities/Optimiser/Base/Enums/Suggestion.php:191
msgid "This page has too many headings. For better readability and SEO, use no more than %d headings per 1000 words."
