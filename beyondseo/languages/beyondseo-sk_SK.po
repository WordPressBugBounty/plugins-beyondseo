msgid "Pages checked: %d"
msgstr "Skontrolované stránky: %d"

msgid "%1$d of %2$d pages could not be checked. You can continue with the completed checks and try again later."
msgstr "%1$d z %2$d strán nebolo možné skontrolovať. Môžete pokračovať s dokončenými kontrolami a skúsiť to znova neskôr."
