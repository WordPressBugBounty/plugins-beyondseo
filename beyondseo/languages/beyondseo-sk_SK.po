msgstr "Vytváraj obsah bez námahy"

msgid "AI Social agent"
msgstr "AI agent pre sociálne médiá"

msgid "Create & publish posts on multiple channels with AI"
msgstr "Vytváraj a zverejňuj príspevky na viacerých kanáloch pomocou AI"

msgid "Create entire series of posts with AI"
msgstr "Vytváraj celé série príspevkov pomocou AI"

msgid "Generate text & images with AI"
msgstr "Generuj text a obrázky pomocou AI"

msgid "Schedule posts in advance"
msgstr "Naplánuj si príspevky vopred"

