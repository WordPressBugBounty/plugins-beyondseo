msgstr "Tjänstens svar kunde inte verifieras. Uppdatera kontot innan du försöker igen. Om anslutningen är ofullständig, kontakta supporten innan du återansluter."

msgid "Project deletion was accepted, but the local connection could not be fully removed. Contact support before retrying or reconnecting. Refresh Account to check the current connection."
msgstr "Projektets radering accepterades, men den lokala anslutningen kunde inte tas bort helt. Kontakta supporten innan du försöker igen eller återansluter. Uppdatera kontot för att kontrollera den aktuella anslutningen."

msgid "The connected project has changed or is no longer connected. Refresh Account and review the project before trying again."
msgstr "Det anslutna projektet har ändrats eller är inte längre anslutet. Uppdatera kontot och granska projektet innan du försöker igen."

msgid "A project operation is already in progress. Wait for it to finish and refresh Account. If this persists, contact support."
msgstr "Ett projektarbete pågår redan. Vänta tills det är klart och uppdatera kontot. Om detta kvarstår, kontakta support."

msgid "Unable to safely start the project operation. Please try again or contact support."
msgstr "Det går inte att starta projektoperationen säkert. Vänligen försök igen eller kontakta supporten."

msgid "Connect your account before creating a project. Refresh Account to check your connection."
msgstr "Anslut ditt konto innan du skapar ett projekt. Uppdatera kontot för att kontrollera din anslutning."

msgid "The service returned a project, but its local connection could not be fully saved. Refresh Account and try again or contact support. Your account and local data have been retained."
msgstr "Tjänsten returnerade ett projekt, men dess lokala anslutning kunde inte sparas helt. Uppdatera kontot och försök igen eller kontakta supporten. Ditt konto och lokala data har sparats."

msgid "Enable communication with rankingCoach in Settings before creating a project."
msgstr "Aktivera kommunikation med rankingCoach i Inställningar innan du skapar ett projekt."

msgid "Enable communication with rankingCoach in Settings before deleting the project. Your local connection has not been removed."
msgstr "Aktivera kommunikation med rankingCoach i inställningarna innan du tar bort projektet. Din lokala anslutning har inte tagits bort."

msgid "The service could not authenticate project creation. Your account data has been retained. Contact support to restore access before retrying."
msgstr "Tjänsten kunde inte autentisera projektets skapande. Dina kontouppgifter har sparats. Kontakta supporten för att återfå åtkomst innan du försöker igen."

msgid "The service could not authenticate project deletion. Your local connection has not been removed. Contact support to restore access before retrying."
msgstr "Tjänsten kunde inte autentisera raderingen av projektet. Din lokala anslutning har inte tagits bort. Kontakta supporten för att återfå åtkomst innan du försöker igen."

msgid "Unable to load the local project connection. Please try again."
msgstr "Kunde inte ladda den lokala projektanslutningen. Vänligen försök igen."

msgid "Account access could not be verified. Reload this page and sign in as an administrator before trying again."
msgstr "Åtkomst till kontot kunde inte verifieras. Ladda om denna sida och logga in som administratör innan du försöker igen."

msgid "Unable to load the local project connection. Check your connection and try again."
msgstr "Kunde inte ladda den lokala projektanslutningen. Kontrollera din anslutning och försök igen."

msgid "The creation result could not be verified. Refresh Account before trying again. Your account and local data have been retained."
msgstr "Skapelseresultatet kunde inte verifieras. Uppdatera kontot innan du försöker igen. Ditt konto och lokala data har behållits."

msgid "The deletion result could not be verified. Refresh Account before trying again. If the connection is incomplete, contact support before reconnecting."
msgstr "Borttagningsresultatet kunde inte verifieras. Uppdatera kontot innan du försöker igen. Om anslutningen är ofullständig, kontakta supporten innan du återansluter."

msgid "The service response could not be verified. Refresh Account before trying again."
msgstr "Tjänstens svar kunde inte verifieras. Uppdatera kontot innan du försöker igen."

msgid "The deletion result could not be verified. Refresh Account before trying again."
msgstr "Borttagningsresultatet kunde inte verifieras. Uppdatera kontot innan du försöker igen."

msgid "Your project is connected. You can open onboarding when you are ready. Your existing onboarding data and status have been preserved."
msgstr "Ditt projekt är kopplat. Du kan öppna onboarding när du är redo. Dina befintliga onboardingdata och status har bevarats."

msgid "Project deletion was accepted and deferred. The local project connection has been removed. Your account, settings, and SEO data are preserved, and the plugin remains active."
msgstr "Projektets radering har accepterats och skjutits upp. Den lokala projektanslutningen har tagits bort. Ditt konto, inställningar och SEO-data är bevarade, och pluginet förblir aktivt."

msgid "The remote project is deleted and the local project connection has been removed. Your account, settings, and SEO data are preserved, and the plugin remains active."
msgstr "Det fjärrprojektet har raderats och anslutningen till det lokala projektet har tagits bort. Ditt konto, inställningar och SEO-data är bevarade, och pluginet förblir aktivt."

