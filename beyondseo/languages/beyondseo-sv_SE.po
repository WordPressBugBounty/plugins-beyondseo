msgstr "Kontot eller projektanslutningen har ändrats. Uppdatera kontot innan du försöker igen."

msgid "Project deletion was accepted, but the local project identifiers could not be fully removed. Your account and local data have been retained. Refresh Account and contact support before creating another project."
msgstr "Projektets radering accepterades, men de lokala projektidentifierarna kunde inte tas bort helt. Ditt konto och lokala data har behållits. Uppdatera kontot och kontakta supporten innan du skapar ett annat projekt."

msgid "Connect your account before creating a project."
msgstr "Anslut ditt konto innan du skapar ett projekt."

msgid "The service did not return a valid project for your account. Refresh Account and try again or contact support."
msgstr "Tjänsten returnerade inte ett giltigt projekt för ditt konto. Uppdatera kontot och försök igen eller kontakta supporten."

msgid "The service could not confirm project deletion. Your local connection has not been removed. Please try again or contact support."
msgstr "Tjänsten kunde inte bekräfta borttagning av projektet. Din lokala anslutning har inte tagits bort. Vänligen försök igen eller kontakta support."

msgid "Unable to confirm project deletion. Your local connection has not been removed. Please try again or contact support."
msgstr "Kunde inte bekräfta raderingen av projektet. Din lokala anslutning har inte tagits bort. Vänligen försök igen eller kontakta supporten."

