msgstr "Ditt konto är anslutet, men ett projekt krävs för att använda BeyondSEO-instrumentpanelen. Skapa ett projekt i Inställningar > Konto för att fortsätta."

msgid "Go to Account"
msgstr "Gå till konto"

msgid "The project location ID is invalid."
msgstr "Projektets plats-ID är ogiltigt."

msgid "The service did not confirm project deletion. Your local connection has not been removed. Please try again or contact support."
msgstr "Tjänsten bekräftade inte projektets borttagning. Din lokala anslutning har inte tagits bort. Vänligen försök igen eller kontakta support."

msgid "SEO titles"
msgstr "SEO-titlar"

msgid "SEO descriptions"
msgstr "SEO-beskrivningar"

msgid "Canonical URLs"
msgstr "Kanoniska URL:er"

msgid "Noindex directives"
msgstr "Noindex-direktiv"

