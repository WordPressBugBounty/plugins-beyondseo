msgstr "Facebook-profiili"

msgid "Twitter profile"
msgstr "Twitter-profiili"

msgid "Instagram profile"
msgstr "Instagram-profiili"

msgid "LinkedIn profile"
msgstr "LinkedIn-profiili"

msgid "YouTube profile"
msgstr "YouTube-profiili"

msgid "Organization or person name"
msgstr "Organisaation tai henkilön nimi"

msgid "Sitemap enabled"
msgstr "Sivustokartta käytössä"

msgid "Google verification code"
msgstr "Googlein vahvistuskoodi"

