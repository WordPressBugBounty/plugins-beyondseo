msgstr "Kanoniset URL-osoitteet"

msgid "Noindex directives"
msgstr "Noindex-ohjeet"

msgid "Social titles"
msgstr "Sosiaaliset tittelit"

msgid "Social descriptions"
msgstr "Sosiaalikuvastot"

