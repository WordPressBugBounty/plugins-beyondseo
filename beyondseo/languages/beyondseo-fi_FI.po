msgstr "Asennusohjelma"

msgid "Your account is connected, but a project is required to use the BeyondSEO dashboard. Create a project in Settings > Account to continue."
msgstr "Tilisi on yhdistetty, mutta BeyondSEO-hallintapaneelin käyttämiseksi tarvitaan projekti. Luo projekti kohdassa Asetukset > Tili jatkaaksesi."

msgid "Go to Account"
msgstr "Mene tiliin"

msgid "The project location ID is invalid."
msgstr "Projektin sijaintitunnus on virheellinen."

msgid "The service did not confirm project deletion. Your local connection has not been removed. Please try again or contact support."
msgstr "Palvelu ei vahvistanut projektin poistamista. Paikallista yhteyttäsi ei ole poistettu. Yritä uudelleen tai ota yhteyttä tukeen."

msgid "SEO titles"
msgstr "SEO-otsikot"

